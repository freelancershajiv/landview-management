LAND_VIEW_API_URL=YOUR_GOOGLE_APPS_SCRIPT_EXEC_URL
LAND_VIEW_PROXY_SECRET=GENERATE_THIS_FROM_APPS_SCRIPT_INITIALIZE_SECURITY_SECRETS

# Transactional email (Resend)
RESEND_API_KEY=re_xxxxxxxxx
RESEND_FROM_EMAIL=LAND VIEW Billing <billing@landview.com.bd>

# WhatsApp — automatic Site Visit announcements to a normal WhatsApp group
# Uses a paired Whapi.Cloud WhatsApp session. Keep the token server-side only.
WHAPI_TOKEN=YOUR_WHAPI_CHANNEL_TOKEN
# Optional override; defaults to https://gate.whapi.cloud
WHAPI_API_BASE=https://gate.whapi.cloud
# LAND VIEW Site Visit group. Either a full normal group ID or the invite code/link can be used.
WHATSAPP_SITE_VISIT_GROUP_ID=
WHATSAPP_SITE_VISIT_GROUP_INVITE_CODE=IyK3AgVZUwB4g3XJ0qokmT
