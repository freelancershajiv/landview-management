LAND_VIEW_API_URL=YOUR_GOOGLE_APPS_SCRIPT_EXEC_URL
LAND_VIEW_PROXY_SECRET=GENERATE_THIS_FROM_APPS_SCRIPT_INITIALIZE_SECURITY_SECRETS

# Transactional email (Resend)
RESEND_API_KEY=re_xxxxxxxxx
RESEND_FROM_EMAIL=LAND VIEW Billing <billing@landview.com.bd>

# WhatsApp Groups API — automatic Site Visit announcements
# Requires a Meta WhatsApp Cloud API business number that is eligible for Groups API.
WHATSAPP_GRAPH_VERSION=vXX.X
WHATSAPP_PHONE_NUMBER_ID=YOUR_META_BUSINESS_PHONE_NUMBER_ID
WHATSAPP_SITE_VISIT_GROUP_ID=YOUR_GROUPS_API_GROUP_ID
WHATSAPP_ACCESS_TOKEN=YOUR_SYSTEM_USER_ACCESS_TOKEN
