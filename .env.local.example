LAND_VIEW_API_URL=YOUR_GOOGLE_APPS_SCRIPT_EXEC_URL
LAND_VIEW_PROXY_SECRET=GENERATE_THIS_FROM_APPS_SCRIPT_INITIALIZE_SECURITY_SECRETS

# Cloudflare R2 — primary private Site Visit photo archive.
# Create an R2 bucket and an Object Read & Write API token restricted to that bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=landview-site-visit-media

# Transactional email (Resend)
RESEND_API_KEY=re_xxxxxxxxx
RESEND_FROM_EMAIL=LAND VIEW Billing <billing@landview.com.bd>

# WhatsApp — automatic Site Visit announcements to the existing normal group
# Messages are queued in Supabase and delivered by the self-hosted Baileys service.
# Vercel uses WHATSAPP_BOT_API_TOKEN. The Render service uses BOT_API_TOKEN,
# and both values must be the same private secret.
WHATSAPP_BOT_API_TOKEN=GENERATE_A_LONG_RANDOM_SECRET
WHATSAPP_BOT_STORE_URL=https://jupzgjlizxivhbmuigua.supabase.co/functions/v1/landview-whatsapp-bot-store
# Set after the Render service is created, e.g. https://landview-whatsapp-bot.onrender.com
WHATSAPP_BOT_URL=
WHATSAPP_SITE_VISIT_GROUP_INVITE_CODE=IyK3AgVZUwB4g3XJ0qokmT
